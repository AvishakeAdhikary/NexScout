# Copy to .env (gitignored). Values here are DEV-ONLY defaults matching docker-compose.yml.
NEXSCOUT_ENV=development
NEXSCOUT_LOG_LEVEL=INFO
NEXSCOUT_LOG_JSON=false
NEXSCOUT_DATABASE_URL=postgresql+psycopg://nexscout_app:nexscout_app_dev@127.0.0.1:5432/nexscout
NEXSCOUT_MIGRATION_DATABASE_URL=postgresql+psycopg://nexscout_owner:nexscout_owner_dev@127.0.0.1:5432/nexscout
# Test DB (pytest). Uses the same roles against the nexscout_test database.
NEXSCOUT_TEST_DATABASE_URL=postgresql+psycopg://nexscout_app:nexscout_app_dev@127.0.0.1:5432/nexscout_test
NEXSCOUT_TEST_MIGRATION_DATABASE_URL=postgresql+psycopg://nexscout_owner:nexscout_owner_dev@127.0.0.1:5432/nexscout_test
# 32-byte base64 key for encrypting stored secrets (generate: python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())")
NEXSCOUT_MASTER_KEY=
# Web -> API origin used by Next.js rewrites
NEXSCOUT_API_ORIGIN=http://127.0.0.1:8000
